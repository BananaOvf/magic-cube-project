<Window x:Class="MagicCube.UI.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Height="400" Width="500" 
        Opacity="0" d:Opacity="1">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     To="1" Duration="0:0:0.5" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="15" Background="White" ClipToBounds="True">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="/Resources/magic-cube.png"
                       Width="180" Height="180"
                       Margin="0,0,0,10"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Text="Magic Cube Simulator" 
                           FontSize="28" FontWeight="Bold"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="v1.0.0" 
                           FontSize="14" Foreground="#222222" Margin="0,5,0,20"
                           HorizontalAlignment="Center"/>

                <ProgressBar IsIndeterminate="True" Width="120" Height="4" 
                             Foreground="#AD2421" Background="#AAAAAA"
                             BorderThickness="0"/>

                <TextBlock Text="Created by github.com/BananaOvf"
                           FontSize="12" Foreground="#444444"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>